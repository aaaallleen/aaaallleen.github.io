---
/**
 * The site window: title bar, toolbar, sidebar + content, status bar.
 * Home, Experience, Projects, CV, Contact and individual posts render here.
 * (The Writing folder uses the Finder layout instead.)
 */
import Shell from './Shell.astro';
import TitleBar from '../components/TitleBar.astro';
import Toolbar from '../components/Toolbar.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../site.config';
import { titles, type SectionKey } from '../data/nav';

interface Props {
  section: SectionKey;
  /** Text in the window's title bar. Defaults to the section title. */
  windowTitle?: string;
  /** Browser tab title. Defaults to "<window title> · Allen Lu". */
  tabTitle?: string;
  description?: string;
  /** Left side of the status bar. Defaults to the mockup's "<title> — <email>". */
  status?: string;
}

const { section, windowTitle = titles[section], tabTitle, description, status } = Astro.props;
const statusText = status ?? `${section === 'home' ? '7 items' : titles[section]} — ${site.email}`;
const pageTitle = tabTitle ?? (section === 'home' ? `${site.name} — ML Infrastructure Engineer` : `${windowTitle} · ${site.name}`);
---
<Shell tabTitle={pageTitle} windowTitle={windowTitle} description={description}>
  <div class="desk">
    <div class="window" data-window-el data-window-kind="site" tabindex="-1" transition:name="site-window">
      <TitleBar title={windowTitle} />
      <Toolbar />
      <div class="body">
        <Sidebar current={section} />
        <main class="content" id="main">
          <slot />
        </main>
      </div>
      <footer class="statusbar">
        <span class="px status">{statusText}</span>
        <span class="px sig">{site.name} &middot; {site.year}</span>
      </footer>
    </div>
  </div>
</Shell>

<style>
  .desk {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(18px, 4vw, 44px) clamp(10px, 3vw, 32px) 0;
  }
  .window {
    background: var(--chrome);
    border: 1px solid var(--line);
    box-shadow: var(--drop);
    outline: none;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 196px) minmax(0, 1fr);
    align-items: stretch;
  }
  .content { background: var(--win); min-width: 0; }
  .statusbar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 5px 10px;
    background: var(--chrome);
    border-top: 1px solid var(--line);
    box-shadow: var(--bev-out);
  }
  .status { font-size: 9px; color: var(--ink-2); }
  .sig { font-size: 9px; color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 760px) {
    .body { grid-template-columns: minmax(0, 1fr); }
  }
</style>
