---
import Desktop from '../../layouts/Desktop.astro';
import { getPosts } from '../../lib/posts';
import { monthYear } from '../../lib/format';
import { url } from '../../lib/url';
const posts = await getPosts();
---
<Desktop section="blog" description="Writing by Allen Lu on GPU profiling, model compilation, and systems.">
  <div class="page">
    <h1 class="section-title tight">WRITING</h1>
    <p class="intro">Profiler traces, compilation failures, and things I built to understand something. Mostly the second one.</p>

    <div class="table">
      <div class="thead" aria-hidden="true">
        <span class="px th">DATE</span>
        <span class="px th">TITLE</span>
        <span class="px th">TOPIC</span>
      </div>
      {posts.map((p) => (
        <a class="row" href={url(`/writing/${p.id}/`)}>
          <span class="px date">{monthYear(p.data.date)}</span>
          <span class="main">
            <span class="t">{p.data.title}</span>
            <span class="dek">{p.data.dek}</span>
          </span>
          <span class="topic">{p.data.topic}</span>
        </a>
      ))}
    </div>
  </div>
</Desktop>

<style>
  .page { padding: var(--pad-y-page) var(--pad-x); }
  .tight { margin-bottom: 8px; }
  .intro { font-size: 13px; color: var(--ink-2); margin: 0 0 28px; max-width: 60ch; }
  .table { border: 1px solid var(--line); box-shadow: var(--bev-in); background: var(--win); }
  .thead, .row {
    display: grid;
    grid-template-columns: minmax(0, 92px) minmax(0, 1fr) minmax(0, 110px);
    gap: 14px;
  }
  .thead { padding: 8px 14px; background: var(--panel); border-bottom: 1px solid var(--line); }
  .th { font-size: 9px; color: var(--ink-3); }
  .row {
    padding: 13px 14px;
    border-bottom: 1px solid var(--line-soft);
    color: inherit; text-decoration: none;
  }
  .row:nth-of-type(even) { background: var(--panel); }
  .row:last-child { border-bottom: 0; }
  .date { font-size: 9px; color: var(--ink-3); padding-top: 3px; }
  .main { min-width: 0; }
  .t { display: block; font-size: 13px; font-weight: 700; line-height: 1.4; }
  .dek { display: block; font-size: 12px; color: var(--ink-2); line-height: 1.55; padding-top: 4px; }
  .topic { font-size: 11px; color: var(--ink-3); padding-top: 3px; }
  @media (max-width: 600px) {
    .thead, .row { grid-template-columns: minmax(0, 92px) minmax(0, 1fr); }
    .th:last-child { display: none; }
    .topic { grid-column: 2; padding-top: 0; }
  }
</style>
