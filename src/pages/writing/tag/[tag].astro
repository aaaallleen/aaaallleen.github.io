---
/** One folder window per tag: /writing/tag/<slug>/ — the Writing list filtered to that tag. */
import Finder from '../../../layouts/Finder.astro';
import FinderList from '../../../components/FinderList.astro';
import { getPosts } from '../../../lib/posts';
import { collectTags, postsWithTag, type TagInfo } from '../../../lib/tags';
import { postRows } from '../../../lib/postRows';
import { sortStatus } from '../../../lib/finder';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props as { tag: TagInfo };
const all = await getPosts();
const tags = collectTags(all);
const rows = postRows(postsWithTag(all, tag.slug));
---
<Finder title={tag.name} tags={tags} activeTag={tag.slug}
  status={sortStatus(rows.length, 'date', 'desc', 'DATE ADDED')}
  description={`Posts by Allen Lu tagged “${tag.name}”.`}>
  <FinderList rows={rows} sortKey="writing" emptyText={`No posts tagged “${tag.name}” yet.`} />
</Finder>
