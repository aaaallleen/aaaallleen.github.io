---
import Desktop from '../layouts/Desktop.astro';
import HeroA from '../components/HeroA.astro';
import HeroB from '../components/HeroB.astro';
import { site } from '../site.config';
import { skills } from '../data/skills';
import { facts } from '../data/facts';
import { getPosts } from '../lib/posts';
import { monthYear } from '../lib/format';
import { url } from '../lib/url';

const recent = (await getPosts()).slice(0, 3);
const Hero = site.heroLayout === 'b' ? HeroB : HeroA;
---
<Desktop section="home">
  <Hero />

  <section class="about">
    <h2 class="section-title">ABOUT ME</h2>
    <div class="grid">
      <div>
        {site.about.paragraphs.map((p) => <p>{p}</p>)}
        <ul class="skills" aria-label="Skills">
          {skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
      <aside class="info">
        <div class="px info-title">GET INFO</div>
        <dl>
          {facts.map((f) => (
            <div class="fact">
              <dt class="px">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <section class="recent">
    <div class="head">
      <h2 class="section-title">RECENT WRITING</h2>
      <a class="px all" href={url('/writing/')}>All posts &gt;</a>
    </div>
    <div class="list">
      {recent.map((p) => (
        <a class="row" href={url(`/writing/${p.id}/`)}>
          <span class="px date">{monthYear(p.data.date)}</span>
          <span>
            <span class="t">{p.data.title}</span>
            <span class="dek">{p.data.dek}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="contact">
    <h2 class="section-title contact-title">CONTACT</h2>
    <div class="cards">
      {site.contacts.map((c) => (
        <a class="card" href={c.href}>
          <span class="px k">{c.k}</span>
          <span class="v">{c.v}</span>
        </a>
      ))}
    </div>
  </section>
</Desktop>

<style>
  section { padding: var(--pad-y) var(--pad-x); border-bottom: 1px solid var(--line-soft); }
  section:last-child { border-bottom: 0; }

  /* About */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 52px);
  }
  .about p { font-size: 14px; line-height: 1.75; margin: 0 0 14px; color: var(--ink-2); }
  .about p:first-child { color: var(--ink); }
  .about p:last-of-type { margin-bottom: 0; }
  .skills { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 4px 9px;
    background: var(--chrome);
    border: 1px solid var(--line);
    box-shadow: var(--bev-out);
    font-size: 10px; color: var(--ink-2);
  }
  .info {
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: var(--bev-in);
    padding: 14px 16px;
    align-self: start;
  }
  .info-title { font-size: 10px; color: var(--ink-3); padding-bottom: 10px; border-bottom: 1px solid var(--line-soft); }
  dl { margin: 0; }
  .fact {
    display: grid; grid-template-columns: minmax(0, 72px) minmax(0, 1fr); gap: 12px;
    padding: 10px 0; border-bottom: 1px solid var(--line-soft);
  }
  dt { font-size: 9px; color: var(--ink-3); padding-top: 2px; }
  dd { margin: 0; font-size: 12px; line-height: 1.5; }

  /* Recent writing */
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .head .section-title { margin: 0; }
  .all { font-size: 10px; color: var(--accent); text-decoration: none; }
  .row {
    display: grid; grid-template-columns: minmax(0, 86px) minmax(0, 1fr); gap: 16px;
    padding: 12px 10px;
    border-bottom: 1px solid var(--line-soft);
    color: inherit; text-decoration: none;
  }
  .row:nth-child(even) { background: var(--panel); }
  .date { font-size: 9px; color: var(--ink-3); padding-top: 3px; }
  .t { display: block; font-size: 13px; font-weight: 700; line-height: 1.4; }
  .dek { display: block; font-size: 12px; color: var(--ink-2); line-height: 1.55; padding-top: 4px; }

  /* Contact */
  .contact-title { margin-bottom: 20px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
  .card {
    display: block;
    padding: 14px 16px;
    background: var(--chrome);
    border: 1px solid var(--line);
    box-shadow: var(--bev-out);
    color: var(--ink); text-decoration: none;
  }
  .k { display: block; font-size: 9px; color: var(--ink-3); margin-bottom: 7px; }
  .v { display: block; font-size: 12px; font-weight: 700; word-break: break-all; }

  @media (max-width: 720px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
