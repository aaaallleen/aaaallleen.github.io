---
import Desktop from '../layouts/Desktop.astro';
import { timeline } from '../data/experience';
---
<Desktop section="experience" description="Allen Lu — work history and education.">
  <div class="page">
    <h1 class="section-title tight">EXPERIENCE</h1>
    <p class="intro">Work on the left, education on the right, one shared spine. Condensed highlights — the full record is on the CV.</p>

    <div class="legend" aria-hidden="true">
      <span class="legend-item"><i class="sq work"></i><span class="px">WORK</span></span>
      <span class="legend-item"><i class="sq edu"></i><span class="px">EDUCATION</span></span>
    </div>

    <ol class="timeline">
      {timeline.map((t) => (
        <li class="row">
          <div class:list={['cell', 'left', t.kind === 'work' ? 'filled' : 'blank']}>
            {t.kind === 'work' && (
              <article class="card work">
                <div class="px dates">{t.dates}</div>
                <h2 class="org">{t.org}</h2>
                <div class="role">{t.role}</div>
                {t.bullets.length > 0 && (
                  <ul class="bullets">
                    {t.bullets.map((b) => <li><i class="dot work"></i><span>{b}</span></li>)}
                  </ul>
                )}
              </article>
            )}
          </div>
          <div class="spine" aria-hidden="true">
            <span class:list={['node', t.kind]}></span>
            <span class="line"></span>
          </div>
          <div class:list={['cell', 'right', t.kind === 'edu' ? 'filled' : 'blank']}>
            {t.kind === 'edu' && (
              <article class="card edu">
                <div class="px dates">{t.dates}</div>
                <h2 class="org">{t.org}</h2>
                <div class="role">{t.role}</div>
                {t.bullets.length > 0 && (
                  <ul class="bullets">
                    {t.bullets.map((b) => <li><i class="dot edu"></i><span>{b}</span></li>)}
                  </ul>
                )}
              </article>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Desktop>

<style>
  .page { padding: var(--pad-y-page) var(--pad-x); }
  .tight { margin-bottom: 8px; }
  .intro { font-size: 13px; color: var(--ink-2); margin: 0 0 30px; max-width: 60ch; }

  .legend { display: flex; gap: 20px; margin-bottom: 24px; }
  .legend-item { display: flex; align-items: center; gap: 7px; }
  .legend .px { font-size: 9px; color: var(--ink-2); }
  .sq { display: block; width: 9px; height: 9px; }
  .sq.work { background: var(--ink); }
  .sq.edu { border: 1px solid var(--ink); }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1fr);
    align-items: start;
  }
  .cell { padding: 0 0 26px; }
  .card { padding: 15px 17px; border: 1px solid var(--line); }
  .card.work { background: var(--panel); box-shadow: var(--drop); }
  .card.edu { background: var(--win); box-shadow: var(--bev-in); }
  .dates { font-size: 9px; color: var(--ink-3); margin-bottom: 8px; }
  .org { font-size: 15px; font-weight: 700; line-height: 1.3; margin: 0; }
  .role { font-size: 12px; color: var(--ink-2); padding: 3px 0 10px; }
  .bullets { list-style: none; margin: 0; padding: 0; }
  .bullets li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 8px; padding-bottom: 6px; }
  .bullets span { font-size: 12px; line-height: 1.6; color: var(--ink-2); }
  .dot { display: block; width: 5px; height: 5px; margin-top: 6px; }
  .dot.work { background: var(--accent); }
  .dot.edu { border: 1px solid var(--ink-3); }

  .spine { justify-self: center; display: flex; flex-direction: column; align-items: center; height: 100%; }
  .node { display: block; width: 13px; height: 13px; border: 1px solid var(--ink); margin-top: 14px; flex: 0 0 auto; }
  .node.work { background: var(--ink); }
  .node.edu { background: var(--win); }
  .line { display: block; width: 1px; flex: 1; background: var(--line); }

  /* Narrow: one column with the spine on the left. */
  @media (max-width: 640px) {
    .row { grid-template-columns: 28px minmax(0, 1fr); }
    .spine { grid-column: 1; grid-row: 1; }
    .cell.filled { grid-column: 2; grid-row: 1; }
    .cell.blank { display: none; }
    .card.edu { box-shadow: var(--drop); }
  }
</style>
