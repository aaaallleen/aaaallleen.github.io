---
/** The Writing table: DATE | TITLE | TAGS. Used by the index and by tag pages. */
import type { Post } from '../lib/posts';
import { monthYear } from '../lib/format';
import { tagSlug } from '../lib/tags';
import { url } from '../lib/url';

interface Props { posts: Post[]; emptyText?: string }
const { posts, emptyText = 'Nothing here yet.' } = Astro.props;
---
<div class="table">
  <div class="thead" aria-hidden="true">
    <span class="px th">DATE</span>
    <span class="px th">TITLE</span>
    <span class="px th">TAGS</span>
  </div>
  {posts.length === 0 && <p class="empty">{emptyText}</p>}
  {posts.map((p) => (
    <div class="row">
      <span class="px date">{monthYear(p.data.date)}</span>
      <a class="main" href={url(`/writing/${p.id}/`)}>
        <span class="t">{p.data.title}</span>
        <span class="dek">{p.data.dek}</span>
      </a>
      <span class="taglist">
        {p.data.tags.map((t) => (
          <a class="tag-chip small" href={url(`/writing/tag/${tagSlug(t)}/`)}>{t}</a>
        ))}
      </span>
    </div>
  ))}
</div>

<style>
  .table { border: 1px solid var(--line); box-shadow: var(--bev-in); background: var(--win); }
  .thead, .row {
    display: grid;
    grid-template-columns: minmax(0, 92px) minmax(0, 1fr) minmax(0, 170px);
    gap: 14px;
  }
  .thead { padding: 8px 14px; background: var(--panel); border-bottom: 1px solid var(--line); }
  .th { font-size: 9px; color: var(--ink-3); }
  .row { padding: 13px 14px; border-bottom: 1px solid var(--line-soft); }
  .row:nth-of-type(even) { background: var(--panel); }
  .row:last-child { border-bottom: 0; }
  .date { font-size: 9px; color: var(--ink-3); padding-top: 3px; }
  .main { min-width: 0; color: inherit; text-decoration: none; }
  .main:hover .t { text-decoration: underline; }
  .t { display: block; font-size: 13px; font-weight: 700; line-height: 1.4; }
  .dek { display: block; font-size: 12px; color: var(--ink-2); line-height: 1.55; padding-top: 4px; }
  .taglist { display: flex; flex-wrap: wrap; gap: 4px; align-content: flex-start; padding-top: 1px; }
  .empty { margin: 0; padding: 18px 14px; font-size: 12px; color: var(--ink-2); }
  @media (max-width: 640px) {
    .thead, .row { grid-template-columns: minmax(0, 92px) minmax(0, 1fr); }
    .th:last-child { display: none; }
    .taglist { grid-column: 2; padding-top: 4px; }
  }
</style>
