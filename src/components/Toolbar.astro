---
import { site } from '../site.config';
import { url } from '../lib/url';
---
<div class="toolbar">
  <div class="group">
    <button class="tb" type="button" data-back data-home={url('/')}>&lt; Back</button>
    <a class="tb" href={url('/')}>Home</a>
  </div>
  <div class="group">
    <a class="tb" href={url(site.cv.file)} download={site.cv.downloadName}>Download CV</a>
  </div>
</div>

<style>
  .toolbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
    padding: 7px 9px;
    background: var(--chrome);
    border-bottom: 1px solid var(--line);
  }
  .group { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
</style>

<script>
  document.querySelector<HTMLButtonElement>('[data-back]')?.addEventListener('click', (e) => {
    const home = (e.currentTarget as HTMLElement).dataset.home ?? '/';
    let cameFromHere = false;
    try { cameFromHere = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch {}
    if (cameFromHere && history.length > 1) history.back();
    else location.href = home;
  });
</script>
