---
/** Appears at the bottom of the screen while the window is minimized. */
interface Props { windowTitle: string }
const { windowTitle } = Astro.props;
---
<div class="dock" data-dock>
  <button class="tile" type="button" data-action="restore" aria-label={`Restore window: ${windowTitle}`}>
    <span class="thumb" aria-hidden="true">
      <span class="thumb-bar"><i></i><i></i><i></i></span>
      <span class="thumb-body"><span class="thumb-side"></span><span class="thumb-main"></span></span>
    </span>
    <span class="px tile-label">{windowTitle}</span>
  </button>
</div>

<style>
  .dock {
    position: fixed; left: 50%; bottom: 16px; z-index: 30;
    transform: translateX(-50%);
    display: none;
    gap: 10px;
    padding: 8px 10px;
    background: var(--chrome);
    border: 1px solid var(--line);
    box-shadow: var(--drop), var(--bev-out);
    animation: dock-in .28s cubic-bezier(.2,.7,.2,1);
  }
  :global(body[data-window="minimized"]) .dock { display: flex; }
  @keyframes dock-in {
    from { transform: translate(-50%, 24px); opacity: 0; }
    to   { transform: translate(-50%, 0); opacity: 1; }
  }

  .tile {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 6px 8px 4px;
    background: none; border: 0;
    cursor: pointer;
    appearance: none;
  }
  .tile:hover .thumb { transform: translateY(-2px); }
  .thumb {
    display: block; width: 76px; height: 50px;
    background: var(--win);
    border: 1px solid var(--line);
    box-shadow: var(--bev-out);
    transition: transform .15s;
    overflow: hidden;
  }
  .thumb-bar {
    display: flex; align-items: center; gap: 2px;
    height: 8px; padding: 0 3px;
    background: linear-gradient(180deg, var(--title-a), var(--title-b));
    border-bottom: 1px solid var(--line);
  }
  .thumb-bar i { display: block; width: 3px; height: 3px; }
  .thumb-bar i:nth-child(1) { background: #FF5F57; }
  .thumb-bar i:nth-child(2) { background: #FEBC2E; }
  .thumb-bar i:nth-child(3) { background: #28C840; }
  .thumb-body { display: flex; height: calc(100% - 9px); }
  .thumb-side { width: 18px; background: var(--panel); border-right: 1px solid var(--line-soft); }
  .thumb-main {
    flex: 1;
    background:
      linear-gradient(var(--line-soft), var(--line-soft)) 6px 8px / 30px 2px no-repeat,
      linear-gradient(var(--line-soft), var(--line-soft)) 6px 14px / 40px 1px no-repeat,
      linear-gradient(var(--line-soft), var(--line-soft)) 6px 18px / 36px 1px no-repeat;
  }
  .tile-label { font-size: 9px; color: var(--ink-2); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
